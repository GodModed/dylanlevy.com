---
import CurtainPanel from "./CurtainPanel.astro";

type Props = {
  color?: string;
  duration?: number;
};

const { color = "#64748b", duration = 2 } = Astro.props;
const clouds = Array.from({ length: 8 }, (_, index) => ({
  "--top": `${(index / 7) * 100}%`,
  "--rotation": `${(Math.random() - 0.5) * 16}deg`,
  "--cloud-tone": `color-mix(in srgb, ${color}, ${index % 2 ? "#cbd5e1" : "#1e293b"} ${18 + Math.random() * 20}%)`,
}));
const raindrops = Array.from({ length: 45 }, () => ({
  "--rain-left": `${Math.random() * 100}%`,
  "--rain-top": `${Math.random() * 100}%`,
  "--rain-speed": `${0.4 + Math.random() * 0.4}s`,
  "--rain-delay": `${-Math.random()}s`,
}));
---

<div
  class="cloud-curtain"
  aria-hidden="true"
  style={{ "--curtain-color": color, "--duration": `${duration}s` }}
>
  <CurtainPanel
    side="left"
    {clouds}
    {raindrops}
    lightningPath="M60 0 35 65 58 60 25 125 48 117 20 200"
    branchPath="M37 101 72 120 80 151"
  />
  <CurtainPanel
    side="right"
    {clouds}
    {raindrops}
    lightningPath="M40 0 65 55 42 70 75 128 52 120 80 200"
    branchPath="M61 103 25 130 15 160"
  />
</div>

<style>
  .cloud-curtain {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: clip;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cloud-curtain {
      display: none;
    }
  }
</style>
