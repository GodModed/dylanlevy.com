---
import NavigationLinks from "../NavigationLinks.astro";
import WordArt from "../WordArt.astro";
---

<footer>
  <WordArt />
  <NavigationLinks layout="vertical" includeHome label="Footer navigation" />
  <div class="footer-info">
    <p>
      Made with <a href="https://astro.build/">Astro</a> and ❤️
    </p>
    <p>&copy; 2026 Dylan Levy. All rights reserved.</p>
  </div>
</footer>

<style>
  footer {
    position: relative;
    z-index: 1;
    max-width: var(--content-width);
    margin: auto;
    padding: 28px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid var(--color-line);
  }

  footer > :first-child {
    flex: 0 0 auto;
  }

  footer > :nth-child(n + 2) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  a {
    text-decoration: none;
    margin: 8px 0;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-skip-ink: none;
  }
  @media (max-width: 700px) {
    footer {
      flex-direction: column;
      gap: 16px;
      padding: 28px 24px;
      text-align: center;
    }

    footer > :nth-child(n + 2) {
      flex: 0 1 auto;
    }

    .footer-info p {
      margin: 4px 0;
    }
  }
</style>
