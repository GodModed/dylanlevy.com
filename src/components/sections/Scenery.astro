---
import Cloud from "../Cloud.astro";
import Moon from "../Moon.astro";
import Sun from "../Sun.astro";
import NightStars from "../NightStars.astro";
---

<div class="scenery" aria-hidden="true">
  <NightStars />
  <div class="sun-moon">
    <Moon color="#f8e7b4" size={75} />
    <Sun color="#fbbf24" size={140} />
  </div>
  <div class="clouds">
    <Cloud size={200} />
    <Cloud size={150} />
    <Cloud size={100} />
  </div>
</div>

<style>
  .scenery {
    position: absolute;
    inset: 0 0 auto;
    height: 1050px;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .scenery .sun-moon {
    position: absolute;
    top: 125px;
    right: 9%;
    width: clamp(80px, 11vw, 130px);
    pointer-events: auto;
    cursor: pointer;
  }

  .scenery .clouds {
    position: absolute;
    inset: 0;
    opacity: 0.7;
  }

  .scenery .clouds > :global(*) {
    position: absolute;
    filter: drop-shadow(0 12px 18px rgb(74 115 156 / 10%));
    animation: drift 18s ease-in-out infinite alternate;
    translate: 0 calc(var(--cloud-scroll, 0px) * var(--cloud-depth));
  }

  .scenery .clouds > :global(:nth-child(1)) {
    width: 260px;
    --cloud-depth: 1;
    left: -70px;
    top: 200px;
    opacity: 0.8;
  }

  .scenery .clouds > :global(:nth-child(2)) {
    width: 190px;
    --cloud-depth: 0.65;
    right: -45px;
    top: 390px;
    opacity: 0.55;
    animation-delay: -6s;
  }

  .scenery .clouds > :global(:nth-child(3)) {
    width: 140px;
    --cloud-depth: 0.35;
    left: 22%;
    top: 530px;
    opacity: 0.35;
    animation-delay: -11s;
  }

  @media (prefers-reduced-motion: reduce) {
    .scenery .clouds > :global(*) {
      animation: none;
      translate: none;
    }
  }

  @media (max-width: 600px) {
    .scenery .sun-moon {
      top: 100px;
      right: 8%;
      width: 64px;
    }
  }

  @keyframes drift {
    0% {
      transform: translateX(-10%);
    }
    100% {
      transform: translateX(10%);
    }
  }
</style>

<script>
  const sunmoon = document.querySelector(".sun-moon");

  sunmoon?.addEventListener("click", () => {
    document.documentElement.classList.toggle("dark");
  });

  const scenery = document.querySelector<HTMLElement>(".scenery");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let cloudFrame = 0;
  const updateClouds = () => {
    cloudFrame = 0;
    if (!scenery || reducedMotion.matches) return;
    const rect = scenery.getBoundingClientRect();
    if (rect.bottom < 0 || rect.top > window.innerHeight) return;
    scenery.style.setProperty(
      "--cloud-scroll",
      `${Math.min(window.scrollY * 0.3, 200)}px`,
    );
  };
  const scheduleClouds = () => {
    if (!cloudFrame) cloudFrame = requestAnimationFrame(updateClouds);
  };
  window.addEventListener("scroll", scheduleClouds, { passive: true });
  reducedMotion.addEventListener("change", scheduleClouds);
  scheduleClouds();
</script>
