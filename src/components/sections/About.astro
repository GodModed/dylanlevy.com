---
import { Image } from "astro:assets";
import traditionalPicture from "../../assets/me/traditional.jpg";
---

<section class="about" id="about" aria-labelledby="about-heading">
    <div class="about-profile">
        <Image
            src={traditionalPicture}
            alt="Dylan Levy in a traditional setting"
            class="about-image"
            width={320}
            height={320}
            fit="cover"
            position="top"
        />
        <div class="profile-details">
            <h3>Dylan Levy</h3>
            <span>CSE @ Ohio State University</span>
        </div>
    </div>

    <div class="about-copy ">
        <h2 id="about-heading">About Me</h2>

        <p>
            I'm Dylan Levy, a Computer Science Engineering student at The Ohio
            State University pursuing a minor in Mathematics. I enjoy building
            applications and solving problems.
        </p>

        <p>
            Outside of programming, I've helped classmates learn computer
            science, participated in hackathons, and volunteered to make
            technology more approachable for seniors. Whether I'm debugging code
            or refining a design, I like the process of getting a little better
            each time.
        </p>

        <ul class="tags" aria-label="Interests and achievements">
            <li>Developer</li>
            <li>Student</li>
        </ul>
    </div>
</section>

<style>
    .about {
        box-sizing: border-box;
        display: grid;
        grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.4fr);
        align-items: center;
        gap: clamp(32px, 5vw, 72px);
        width: min(100%, 1080px);
        margin: clamp(80px, 10vw, 140px) auto;
        padding-inline: 24px;
        scroll-margin-top: 32px;
    }

    .about-profile {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
        padding-block: 24px;
        text-align: center;
    }

    .about-image {
        display: block;
        width: 160px;
        height: 160px;
        object-fit: cover;
        border-radius: 50%;
        object-position: top;
        outline: 1px solid var(--color-line);
        outline-offset: 8px;
    }

    .profile-details h3 {
        margin: 0 0 6px;
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.3;
    }

    .profile-details span {
        color: var(--color-muted);
        font-size: 0.8rem;
        line-height: 1.5;
    }

    .about-copy {
        min-width: 0;
        padding-left: clamp(24px, 4vw, 48px);
        border-left: 1px solid var(--color-line);
    }

    .about-copy h2 {
        margin: 0 0 20px;
        font-size: clamp(1.75rem, 3vw, 2.25rem);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.15;
        text-wrap: balance;
    }

    .about-copy p {
        margin: 0;
        color: var(--color-muted);
        font-size: 0.95rem;
        line-height: 1.85;
        text-wrap: pretty;
    }

    .about-copy p + p {
        margin-top: 16px;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 24px 0 0;
        padding: 0;
        list-style: none;
    }

    .tags li {
        padding: 6px 12px;
        border: 1px solid var(--color-line);
        border-radius: 999px;
        color: var(--color-muted);
        font-size: 0.75rem;
        line-height: 1.4;
    }

    @media (max-width: 700px) {
        .about {
            grid-template-columns: 1fr;
            gap: 32px;
        }

        .about-profile {
            flex-direction: row;
            justify-content: flex-start;
            gap: 24px;
            padding: 0;
            text-align: left;
        }

        .about-image {
            flex-shrink: 0;
            width: 88px;
            height: 88px;
            outline-offset: 5px;
        }

        .profile-details {
            min-width: 0;
        }

        .profile-details h3 {
            font-size: 1.125rem;
        }

        .about-copy {
            padding: 28px 0 0;
            border-left: 0;
            border-top: 1px solid var(--color-line);
        }
    }
</style>
