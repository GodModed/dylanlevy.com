---
import NavigationLinks from "../NavigationLinks.astro";
import WordArt from "../WordArt.astro";
---

<header>
  <WordArt />
  <NavigationLinks />
</header>

<style>
  header {
    max-width: var(--content-width);
    margin: auto;
    padding: 28px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  @media (max-width: 600px) {
    header {
      flex-direction: column;
      justify-content: center;
      gap: 14px;
      padding: 20px 24px;
    }
  }
</style>
