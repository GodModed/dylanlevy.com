---
import "@fontsource/inter";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="og:title" content={title} />
    <meta name="og:description" content={description} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
	<GoogleAnalytics />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  :root {
    --color-sky: #d8eff7;
    --color-ink: #203e51;
    --color-line: rgb(32 62 81 / 0.15);
    --color-muted: #536f80;

    --content-width: 1200px;

    font-family: "Inter", sans-serif;
    color: var(--color-ink);
    background: var(--color-sky);
    scroll-behavior: smooth;
    scroll-padding-top: 2rem;
  }

  :root.dark {
    --color-sky: #132b43;
    --color-ink: #edf5fc;
    --color-line: rgb(220 235 250 / 0.2);
    --color-muted: #acc2d5;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 280px;
  }

  a {
    color: inherit;
  }

  button {
    font-family: inherit;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 3px solid #d29233;
    outline-offset: 5px;
  }

  ::selection {
    background: #f5d28e;
    color: #203e51;
  }

  .fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeIn 1s ease forwards;
    animation-delay: calc(var(--fade-in-index, 0) * 0.3s + 0.5s);
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :root {
      scroll-behavior: auto;
    }
    .fade-in {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>(".fade-in")
    .forEach((element, index) => {
      element.style.setProperty("--fade-in-index", index + "");
    });

  const date = new Date();
  if (date.getHours() >= 18 || date.getHours() < 6) {
    document.documentElement.classList.add("dark");
  }
</script>
