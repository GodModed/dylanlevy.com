---
import About from '../components/About.astro';
import Education from '../components/Education.astro';
import CloudCurtain from '../components/CloudCurtain.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dylan Levy - Developer & Ohio State CSE Student" description="I am a software developer, empowering the modern web with innovative solutions.">
	<Header />
	<Hero />
	<div class="divider" aria-hidden="true"></div>
	<About />
	<Education />
	<CloudCurtain duration={2.5} />
</Layout>

<style>
	.divider {
		max-width: var(--content-width);
		height: 1px;
		background: var(--color-line);
		margin: 0 auto 80px;
	}
</style>